# Web service (SvelteKit / adapter-node) environment.
#
# This is the web image's OWN configuration surface, separate from the Go backend's
# config.example.yaml (ADR-0014): the two services are separate images. Landing-page
# settings live here, not in that file — a key there would trip the backend's
# sample-config drift guard, which asserts in both directions (ADR-0015 §4/§5).
#
# These are runtime environment variables. Copy to .env for local use, or set them on
# the web container. All are optional; the defaults reproduce today's behaviour.

# --- Transport / wiring ---------------------------------------------------------------

# The backend origin, reachable over the internal compose network. The web service is
# the public edge and proxies /api/v1 to this.
BACKEND_ORIGIN=http://localhost:8080

# The public origin the browser uses; must match the host you browse to (SvelteKit's
# CSRF origin check). Override for a remote/production host.
ORIGIN=http://localhost:3000

# The port and interface the web server listens on (adapter-node).
PORT=3000
HOST=0.0.0.0

# --- Root page (ADR-0015, #256) -------------------------------------------------------

# What a SIGNED-OUT visitor sees at the site root. An authenticated visitor is always
# sent on to /lists regardless of this setting.
#   bundled  the shipped marketing landing (default; also used for any unrecognized value)
#   login    redirect signed-out visitors straight to /login (a private instance)
#   custom   the bundled layout with your own words (the slots below)
# Unset behaves exactly as today.
YAADEGAR_ROOT_PAGE=bundled

# Used only when YAADEGAR_ROOT_PAGE=custom. Each is inserted as text (or, for the CTA
# href, as an allowlisted URL) — never as HTML. Any slot left unset keeps the bundled
# wording, so `custom` with nothing set is the bundled copy.
#YAADEGAR_ROOT_HEADLINE=Wishes worth keeping — surprises kept safe
#YAADEGAR_ROOT_SUBHEAD=Share your wishlist with the people you love, without spoiling the surprise.
#YAADEGAR_ROOT_CTA_LABEL=Create your list
# CTA destination: http/https or a site-relative /path only. Anything else (a
# javascript:/data: scheme, a protocol-relative //host) is rejected and the default is used.
#YAADEGAR_ROOT_CTA_HREF=/login
#YAADEGAR_ROOT_TRUST_LINE=Free & Open Source
